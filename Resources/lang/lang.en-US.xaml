    <v:String x:Key="AboutPage_OriginText">Built on the open-source BedrockLauncher foundation and redesigned as a custom XylarBedrock launcher experience.</v:String>
    <v:String x:Key="AboutPage_GithubButton">Open GitHub</v:String>
    <v:String x:Key="AboutPage_TeamTitle">Team</v:String>
    <v:String x:Key="AboutPage_TeamText">The people keeping this build alive.</v:String>
    <v:String x:Key="AboutPage_MrmariixRole">FOUNDER</v:String>
    <v:String x:Key="AboutPage_MrmariixText">Founder. Idea, direction and the message behind the launcher.</v:String>
    <v:String x:Key="AboutPage_SasyRole">VICE FOUNDER</v:String>
    <v:String x:Key="AboutPage_SasyText">Vice founder. Helped push the Xylar side of the project forward.</v:String>
    <v:String x:Key="AboutPage_RedShadowRole">SPECIAL THANKS</v:String>
    <v:String x:Key="AboutPage_RedShadowText">The Red Shadow gave the idea that kicked this app into motion.</v:String>
